# PostgreSQL
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_parser
DATABASE_URL=postgresql+asyncpg://avito:avito@db:5432/avito_parser

# OpenAI
OPENAI_API_KEY=sk-...

# 2GIS
TWOGIS_API_KEY=...

# DaData (ФНС/ЕГРЮЛ/ЕГРИП)
DADATA_API_KEY=...
DADATA_SECRET_KEY=...

# ФССП
FSSP_API_TOKEN=...

# Residential proxy для Avito/Yandex
# Вариант 1 — один прокси
PROXY_URL=http://user:pass@proxy.host:port
# Вариант 2 — файл с несколькими прокси (приоритет над PROXY_URL)
# PROXY_FILE=proxies.txt

# Pipeline settings
DEDUP_THRESHOLD=85
CONFIDENCE_THRESHOLD=70
MAX_REVIEWS_PER_COMPANY=200

# Scheduler (cron expression, default: every Monday 03:00)
SCHEDULER_CRON=0 3 * * 1

# Stage 2 Review Enrichment (Flamp, VK, Otzovik)
VK_ACCESS_TOKEN=            # Бесплатный сервисный токен: vk.com/apps → Сервисный ключ
SERPAPI_KEY=                # Опционально, улучшает качество поиска ($50/мес за 5K запросов)
ENABLE_REVIEW_ENRICHMENT=true
