# PostgreSQL
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_parser
DATABASE_URL=postgresql+asyncpg://avito:avito@db:5432/avito_parser

# OpenAI
OPENAI_API_KEY=sk-...

# DaData (ФНС/ЕГРЮЛ/ЕГРИП)
DADATA_API_KEY=...
DADATA_SECRET_KEY=...

# Proxy для Playwright-скраперов (Avito, Yandex, 2GIS, VK web, ФССП web)
# Вариант 1 — один прокси
PROXY_URL=http://user:pass@proxy.host:port
# Вариант 2 — файл с несколькими прокси (приоритет над PROXY_URL)
# PROXY_FILE=proxies.txt

# SX.org proxy API (ключ сохранён, подключение будет настроено отдельно)
SX_PROXY_API_KEY=...

# Avito cookies через spfa.ru — обход файрвола Авито без Playwright
# Регистрация: https://spfa.ru | ~12₽/набор, работает 12+ часов
# Без этого ключа коллектор работает только через прокси (может блокировать)
AVITO_COOKIES_API_KEY=

# Pipeline settings
DEDUP_THRESHOLD=85
CONFIDENCE_THRESHOLD=70
MAX_REVIEWS_PER_COMPANY=200

# Scheduler (cron expression, default: every Monday 03:00)
SCHEDULER_CRON=0 3 * * 1

# Stage 2 Review Enrichment (Flamp, VK web, Otzovik)
SERPAPI_KEY=          # Опционально, улучшает качество поиска ($50/мес за 5K запросов)
ENABLE_REVIEW_ENRICHMENT=true
