# PostgreSQL
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_parser
DATABASE_URL=postgresql+asyncpg://avito:avito@db:5432/avito_parser

# OpenAI (суммаризация отзывов, GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# DaData (ФНС/ЕГРЮЛ/ЕГРИП)
DADATA_API_KEY=...
DADATA_SECRET_KEY=...

# SX.org proxy (RU для скрапинга, US для OpenAI API)
# Получить ключ: https://sx.org → Developers → API Key
SX_PROXY_API_KEY=...
# Port IDs (заполнятся автоматически при первом запуске, сохраните для переиспользования)
# SX_PROXY_PORT_ID_RU=
# SX_PROXY_PORT_IDS_RU=12345,12346,12347
# SX_PROXY_PORT_ID_US=
# Размер пула RU-прокси в памяти (round-robin)
# SX_PROXY_RU_POOL_SIZE=3
# Разрешить автоматическую покупку портов (держите false на проде)
# SX_PROXY_ALLOW_CREATE=false

# Fallback прокси (используется только если SX_PROXY_API_KEY не задан)
# PROXY_URL=http://user:pass@proxy.host:port
# PROXY_FILE=proxies.txt

# Avito cookies через spfa.ru — обход файрвола Авито
# Регистрация: https://spfa.ru | ~12₽/набор, работает 12+ часов
AVITO_COOKIES_API_KEY=

# Pipeline settings
DEDUP_THRESHOLD=85
CONFIDENCE_THRESHOLD=70
MAX_REVIEWS_PER_COMPANY=200
# Collector keyword concurrency (semaphore in collectors)
AVITO_MAX_KEYWORDS=20
YANDEX_MAX_KEYWORDS=20
TWOGIS_MAX_KEYWORDS=20
# Backward-compatible global fallback (for collectors without dedicated limits)
# COLLECTOR_MAX_KEYWORDS=3
# PLAYWRIGHT_MAX_KEYWORDS=2

# Scheduler (cron expression, default: every Monday 03:00)
SCHEDULER_CRON=0 3 * * 1

# 2GIS settings
TWOGIS_SEARCH_REGION=true
# TWOGIS_DEBUG_BROWSER=false
# TWOGIS_SEARCH_MAX_PAGES=8
# TWOGIS_FIRM_WORKERS=4

# Yandex settings
# YANDEX_DEBUG=false
# YANDEX_BROWSER_RESTART_ATTEMPTS=3

# Stage 2 Review Enrichment (Flamp, VK web, Otzovik)
SERPAPI_KEY=
ENABLE_REVIEW_ENRICHMENT=true
# ENABLE_PHONE_PARSING=true

# Optional advanced settings
# ENRICH_CONCURRENCY=5
# AI_CONCURRENCY=5
# TWOGIS_TABS_PER_BROWSER=3
# TWOGIS_COMPANY_RETRY_ATTEMPTS=2
# TWOGIS_RETRY_UNTIL_SUCCESS=true
# TWOGIS_MAX_PROXY_ROTATIONS=30
# YANDEX_DEBUG_SLOW_MO_MS=0
# YANDEX_DEBUG_HOLD_SECONDS=0
# YANDEX_DEBUG_SCREENSHOT_PATH=storage/yandex_debug_last.png
# YANDEX_STATE_VIEW_IMMEDIATE=true
# YANDEX_SINGLE_PASS=true
