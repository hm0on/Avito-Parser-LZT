# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_parser
# Docker network: use @db (service name). For local dev: @localhost
DATABASE_URL=postgresql+asyncpg://avito:avito@db:5432/avito_parser

# ── OpenAI (summarization, optional) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_PROXY_FILE=storage/proxies/openai.txt
# OPENAI_PROXY_URL=http://user:pass@proxy.host:port

# ── SPFA (Avito phone lookup by ad URL) ───────────────────────────────────
SPFA_API_KEY=
SPFA_PHONE_ENDPOINT=https://spfa.ru/api/phone/
SPFA_TIMEOUT_SECONDS=30

# ── DaData (FNS/EGRUL/EGRIP) ─────────────────────────────────────────────
DADATA_API_KEY=...
DADATA_SECRET_KEY=...

# ── Proxy configuration ──────────────────────────────────────────────────
# Proxy files: one proxy per line, format: scheme://user:pass@host:port
# Supported schemes: http, https, socks5
PROXY_STORAGE_DIR=storage/proxies
# PROXY_URL=socks5://user:pass@proxy.host:port
# PROXY_FILE=proxies.txt
AVITO_PROXY_FILE=storage/proxies/avito.txt
YANDEX_PROXY_FILE=storage/proxies/yandex.txt
TWOGIS_PROXY_FILE=storage/proxies/twogis.txt
ENRICHMENT_PROXY_FILE=storage/proxies/enrichment.txt
WEBSITE_PROXY_FILE=storage/proxies/website.txt
WEBSITE_PROXY_SCHEME=

# SX.org proxy API key (stored, not yet wired)
# SX_PROXY_API_KEY=...

# ── Avito (Playwright browser + proxy) ───────────────────────────────────
AVITO_BROWSER_NAME=chromium
AVITO_BROWSER_HEADLESS=true
AVITO_PROXY_SCHEME=socks5
AVITO_PROXY_FALLBACK_SCHEME=
AVITO_PROXY_MAX_ROTATIONS=20
AVITO_PROXY_FAIL_COOLDOWN_SECONDS=90
AVITO_REQUEST_MIN_INTERVAL_SECONDS=4
AVITO_FETCH_RETRIES=3
AVITO_PAGE_TIMEOUT_MS=180000
AVITO_MAX_PAGES=20
AVITO_REVIEW_PAUSE_SECONDS=1.0
AVITO_REVIEW_WORKERS=3
ENABLE_AVITO_REVIEW_PARSING=true
AVITO_SEARCH_AREAS=omsk,omskaya_oblast

# ── Avito proxy precheck ─────────────────────────────────────────────────
AVITO_PRECHECK_ENABLED=true
AVITO_PRECHECK_CONCURRENCY=20
AVITO_PRECHECK_TIMEOUT_SECONDS=10
AVITO_PRECHECK_SAMPLE_SIZE=0
AVITO_PRECHECK_MIN_USABLE=1
AVITO_PRECHECK_MIN_AVITO_OK=1
AVITO_RETRY_JITTER_MAX_SECONDS=2.0

# ── 2GIS (Playwright UI scraper) ─────────────────────────────────────────
# Optional forced proxy scheme for 2GIS (http/socks5).
# Leave empty to use scheme from storage/proxies/twogis.txt as-is.
TWOGIS_PROXY_SCHEME=
TWOGIS_DEBUG_BROWSER=false
TWOGIS_SEARCH_MAX_PAGES=8
TWOGIS_FIRM_WORKERS=4
TWOGIS_TABS_PER_BROWSER=3
TWOGIS_COMPANY_RETRY_ATTEMPTS=2
TWOGIS_RETRY_UNTIL_SUCCESS=true
TWOGIS_MAX_PROXY_ROTATIONS=30
TWOGIS_FLAMP_FALLBACK_ENABLED=true
TWOGIS_SEARCH_AREAS=Омск,Омская область

# ── Yandex (Playwright Maps scraper) ─────────────────────────────────────
YANDEX_BROWSER_RESTART_ATTEMPTS=3
YANDEX_STATE_VIEW_IMMEDIATE=true
YANDEX_SINGLE_PASS=true
YANDEX_REVIEWS_MAX_ATTEMPTS=3
# Debug mode (visible browser, for local dev only, NOT server)
# YANDEX_DEBUG=false
# YANDEX_DEBUG_SLOW_MO_MS=0
# YANDEX_DEBUG_HOLD_SECONDS=0

# ── Pipeline settings ────────────────────────────────────────────────────
DEDUP_THRESHOLD=85
CONFIDENCE_THRESHOLD=70
MAX_REVIEWS_PER_COMPANY=200
PIPELINE_PARALLEL_SOURCES=true
PIPELINE_SOURCE_PARALLELISM=3
ENRICHMENT_WORKERS=12
AI_WORKERS=16
REVIEW_SEARCH_MAX_QUERIES=2
WEBSITE_SCAN_MAX_PAGES=8
WEBSITE_SCAN_MAX_IMAGES=2
WEBSITE_SCAN_MAX_PDFS=2
WEBSITE_SCAN_TIMEOUT_SECONDS=10
WEBSITE_SCAN_ENABLE_OCR=false
STRICT_LEGAL_MATCH=true
LEGAL_BINDING_MEMORY_ENABLED=true
LEGAL_NAME_MATCH_MIN_OVERLAP=0.95
LEGAL_AUTO_APPLY_NAME_LOOKUP=false
RELEVANCE_MIN_CONFIDENCE=0.75
RELEVANCE_MODEL=gpt-4o
RELEVANCE_TIMEOUT_SECONDS=90
RELEVANCE_MAX_ATTEMPTS=3
RELEVANCE_USE_OPENAI=true
SEARCH_PLUMBING_KEYWORDS=бурение скважин на воду,скважина под ключ,артезианская скважина,септик под ключ,автономная канализация,выгребная яма из ЖБ колец,колодец на воду,копка колодцев,горизонтально направленное бурение,ГНБ Омск,монтаж отопления,водоочистка,водопровод и канализация,алмазное бурение
ENABLE_ADJACENT_SERVICES=false
TARGET_GEO_MODE=strict_omsk_oblast
TARGET_GEO_TERMS=омск,омская область,калачинск,исилькуль,тюкалинск,таврическое,муромцево,марьяновка,любинский,азово,черлак,большеречье,нововаршавка,называевск,кормиловка,павлоградка,саргатское

# ── Scheduler (weekly cron, server timezone) ─────────────────────────────
SCHEDULER_CRON=0 3 * * 0
SCHEDULER_TIMEZONE=Europe/Moscow

# ── Review Enrichment (Stage 2: Flamp, VK, Otzovik) ─────────────────────
# SERPAPI_KEY=             # Optional, improves search ($50/mo for 5K queries)
ENABLE_REVIEW_ENRICHMENT=true
AVITO_LIGHT_ENRICHMENT=true
ENABLE_PHONE_PARSING=true
# DDG search is unreliable in production (rate limits, blocks). Disabled by default.
ENABLE_DDG_SEARCH=false
FLAMP_MAX_REVIEWS_PER_COMPANY=15
FLAMP_MAX_ATTEMPTS=5
FLAMP_TIMEOUT_SECONDS=15

# ── List-org registry checker (primary enrichment source) ────────────────
LISTORG_ENABLED=true
LISTORG_PRIMARY=true
LISTORG_ALLOW_NAME_LOOKUP=false
# In production, list-org is sufficient — legacy fallback not needed
LISTORG_FALLBACK_ENABLED=false
LISTORG_TIMEOUT_SECONDS=20
LISTORG_RATE_LIMIT_RPS=1.5
LISTORG_MAX_ATTEMPTS=4
LISTORG_USE_ENRICHMENT_PROXY=true
LISTORG_NAME_MATCH_MIN_SCORE=0.75

# ── Rusprofile fallback (used when list-org did not find company) ────────
RUSPROFILE_ENABLED=true
RUSPROFILE_TIMEOUT_SECONDS=20
RUSPROFILE_MAX_ATTEMPTS=3
RUSPROFILE_USE_ENRICHMENT_PROXY=false
RUSPROFILE_ALLOW_NAME_LOOKUP=false
RUSPROFILE_NAME_MATCH_MIN_SCORE=0.75

# ── OpenAI fallback for company profile hints (last resort) ───────────────
OPENAI_COMPANY_FALLBACK_ENABLED=true
OPENAI_COMPANY_FALLBACK_MODEL=gpt-4o
OPENAI_COMPANY_FALLBACK_TIMEOUT_SECONDS=90
OPENAI_COMPANY_FALLBACK_MAX_ATTEMPTS=5
OPENAI_COMPANY_FALLBACK_USE_PROXY=true
OPENAI_QUALITY_PROFILE=true
SUMMARIZER_MODEL=gpt-4o
SUMMARIZER_MAX_TOKENS=2400
SUMMARIZER_TEMPERATURE=0.2
SUMMARIZER_WORKERS=2
SUMMARIZER_MAX_INPUT_REVIEWS=80

# ── FSSP (bailiff) ───────────────────────────────────────────────────────
# FSSP checker is disabled by default (unreliable captcha + slow).
# List-org provides FSSP signals as part of its page parse.
ENABLE_FSSP_CHECK=false
FSSP_PROCESSING_RETRY_DELAY_SECONDS=1800
FSSP_PROCESSING_MAX_RETRIES=4

# ── Docker API port (host mapping) ───────────────────────────────────────
# API_PORT=8000
