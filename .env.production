# ============================================================
# .env.production — серверная конфигурация
# Скопируй этот файл на сервер как .env:
#   cp .env.production .env
# Затем заполни API-ключи.
# ============================================================

# PostgreSQL (ВАЖНО: хост "db" — имя контейнера в docker-compose)
POSTGRES_USER=avito
POSTGRES_PASSWORD=avito
POSTGRES_DB=avito_parser
DATABASE_URL=postgresql+asyncpg://avito:avito@db:5432/avito_parser

# OpenAI
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# DaData (ФНС/ЕГРЮЛ/ЕГРИП)
DADATA_API_KEY=<YOUR_DADATA_API_KEY>
DADATA_SECRET_KEY=<YOUR_DADATA_SECRET_KEY>

# SX.org proxy
SX_PROXY_API_KEY=<YOUR_SX_PROXY_API_KEY>
# Port IDs (заполнятся автоматически при первом запуске, сохраните для переиспользования)
# SX_PROXY_PORT_ID_RU=
# SX_PROXY_PORT_ID_US=
SX_PROXY_ALLOW_CREATE=true

# Avito cookies (spfa.ru)
AVITO_COOKIES_API_KEY=<YOUR_AVITO_COOKIES_API_KEY>

# SerpAPI (для поиска отзывов)
SERPAPI_KEY=<YOUR_SERPAPI_KEY>
ENABLE_REVIEW_ENRICHMENT=true

# Pipeline
DEDUP_THRESHOLD=85
CONFIDENCE_THRESHOLD=70
MAX_REVIEWS_PER_COMPANY=200

# Scheduler (каждый понедельник 03:00)
SCHEDULER_CRON=0 3 * * 1

# ── Debug: ВСЁ ВЫКЛЮЧЕНО на сервере ──────────────────────────
YANDEX_DEBUG=false
TWOGIS_DEBUG_BROWSER=false

# ── Производительность (сервер 62GB RAM) ─────────────────────
# Параллелизм пайплайна
ENRICH_CONCURRENCY=15
AI_CONCURRENCY=10
# Параллелизм коллекторов по ключевым словам (пер-источник)
AVITO_MAX_KEYWORDS=20
YANDEX_MAX_KEYWORDS=20
TWOGIS_MAX_KEYWORDS=20
# Глобальный fallback для коллекторов без отдельного лимита
COLLECTOR_MAX_KEYWORDS=6
PLAYWRIGHT_MAX_KEYWORDS=4

# 2GIS
TWOGIS_SEARCH_REGION=False
TWOGIS_SEARCH_MAX_PAGES=20
TWOGIS_FIRM_WORKERS=10
TWOGIS_TABS_PER_BROWSER=5
TWOGIS_COMPANY_RETRY_ATTEMPTS=3
TWOGIS_RETRY_UNTIL_SUCCESS=true
TWOGIS_MAX_PROXY_ROTATIONS=30

# Yandex
YANDEX_BROWSER_RESTART_ATTEMPTS=3
YANDEX_STATE_VIEW_IMMEDIATE=true
